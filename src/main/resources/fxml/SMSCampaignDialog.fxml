<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.nasroul.ui.PhosphorIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nasroul.controller.SMSCampaignDialogController"
      spacing="14" prefWidth="620">
    <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>

    <VBox spacing="4">
        <Label text="Campagne SMS de rappel" styleClass="dialog-title"/>
        <Label fx:id="lblEntityInfo" styleClass="text-muted"/>
    </VBox>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="34"/>
            <ColumnConstraints percentWidth="66"/>
        </columnConstraints>

        <Label text="Groupe cible*" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cbGroup" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>

        <Label text="Destinataires" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="lblRecipientCount" text="0" styleClass="font-semibold" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Solde SMS" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="lblSMSBalance" text="Vérification…" styleClass="font-semibold" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <VBox spacing="6">
        <Label text="Message*" styleClass="font-semibold"/>
        <Label styleClass="stat-hint" text="Cliquez sur une variable pour l'insérer dans le message :"/>
        <FlowPane fx:id="variablesPane" hgap="6" vgap="6"/>
        <TextArea fx:id="txtMessage" prefRowCount="5"
                  promptText="Assalamou aleykoum {prenom}, il vous reste {montant_restant} CFA à payer pour {nom_evenement}."/>
        <Label fx:id="lblCharCount" styleClass="stat-hint" text="0 caractères"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Aperçu du premier message" styleClass="font-semibold"/>
        <TextArea fx:id="txtPreview" editable="false" prefRowCount="3"/>
    </VBox>

    <VBox fx:id="progressContainer" spacing="6" visible="false" managed="false">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Envoi en cours…" styleClass="font-semibold"/>
            <Label fx:id="lblProgress" styleClass="text-muted" text="0/0"/>
        </HBox>
        <ProgressBar fx:id="progressBar" maxWidth="Infinity"/>
    </VBox>

    <HBox styleClass="action-bar">
        <Button text="Annuler" onAction="#handleCancel" styleClass="secondary-button" cancelButton="true"/>
        <Button fx:id="btnSend" text="Envoyer" onAction="#handleSend" styleClass="primary-button">
            <graphic><PhosphorIcon icon="PAPER_PLANE_TILT" size="15"/></graphic>
        </Button>
    </HBox>

</VBox>
