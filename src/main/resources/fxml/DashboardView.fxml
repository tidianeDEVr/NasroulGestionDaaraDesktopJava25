<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import com.nasroul.ui.PhosphorIcon?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nasroul.controller.DashboardController"
            fitToWidth="true">

    <VBox styleClass="container" spacing="16">

        <!-- Ligne 1 : trésorerie (hero) + indicateurs -->
        <HBox spacing="16">
            <VBox styleClass="hero-card" HBox.hgrow="ALWAYS" spacing="6" minWidth="280">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <PhosphorIcon icon="WALLET" size="16" style="-fx-text-fill: #A5D96A;"/>
                    <Label styleClass="hero-muted" text="Trésorerie"/>
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="8">
                    <Label fx:id="cashOnHandLabel" styleClass="hero-value" text="0"/>
                </HBox>
                <Label styleClass="hero-muted" text="Cotisations payées − dépenses"/>
            </VBox>

            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="200">
                <Label styleClass="stat-label" text="Cotisations payées"/>
                <Label fx:id="lblTotalPaid" styleClass="stat-value, stat-value-success" text="0 CFA"/>
                <Label styleClass="stat-hint" text="Encaissées à ce jour"/>
            </VBox>

            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="200">
                <Label styleClass="stat-label" text="Cotisations en attente"/>
                <Label fx:id="lblTotalPending" styleClass="stat-value, stat-value-warning" text="0 CFA"/>
                <Label styleClass="stat-hint" text="À confirmer"/>
            </VBox>

            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" minWidth="200">
                <Label styleClass="stat-label" text="Dépenses"/>
                <Label fx:id="totalExpensesLabel" styleClass="stat-value, stat-value-danger" text="0 CFA"/>
                <Label styleClass="stat-hint" text="Toutes collectes"/>
            </VBox>
        </HBox>

        <!-- Ligne 2 : progression + recouvrement -->
        <HBox spacing="16">
            <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="12">
                <Label text="Cotisations par collecte" styleClass="section-subtitle"/>
                <BarChart fx:id="contributionBarChart" legendVisible="true" prefHeight="280" animated="false">
                    <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                    <yAxis><NumberAxis label="Montant (CFA)" side="LEFT"/></yAxis>
                </BarChart>
            </VBox>

            <VBox styleClass="content-card" spacing="12" prefWidth="320" minWidth="280">
                <Label text="Taux de recouvrement" styleClass="section-subtitle"/>
                <HBox alignment="BASELINE_LEFT" spacing="10">
                    <Label fx:id="lblCollectionRate" styleClass="stat-value" text="0 %"/>
                </HBox>
                <ProgressBar fx:id="recoveryProgress" maxWidth="Infinity" progress="0"/>
                <HBox spacing="6">
                    <Label styleClass="stat-hint" text="Montant attendu :"/>
                    <Label fx:id="lblTotalExpected" styleClass="stat-hint" text="0 CFA"/>
                </HBox>
                <Region VBox.vgrow="ALWAYS"/>
                <Label styleClass="stat-hint" wrapText="true"
                       text="Attendu = somme des objectifs par groupe × effectif de chaque groupe."/>
            </VBox>
        </HBox>

        <!-- Ligne 3 : répartitions -->
        <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="14" minWidth="0">
                <Label text="Événements par statut" styleClass="section-subtitle"/>
                <VBox fx:id="eventsBreakdown" spacing="12"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="14" minWidth="0">
                <Label text="Projets par statut" styleClass="section-subtitle"/>
                <VBox fx:id="projectsBreakdown" spacing="12"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="content-card" spacing="14" minWidth="0">
                <Label text="Méthodes de paiement" styleClass="section-subtitle"/>
                <VBox fx:id="paymentMethodsBreakdown" spacing="12"/>
            </VBox>
        </HBox>

        <!-- Actions rapides -->
        <HBox styleClass="content-card" alignment="CENTER_LEFT" spacing="12">
            <Label text="Actions rapides" styleClass="section-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nouveau membre" onAction="#handleNewMember" styleClass="secondary-button">
                <graphic><PhosphorIcon icon="USER_PLUS" size="15"/></graphic>
            </Button>
            <Button text="Nouvel événement" onAction="#handleNewEvent" styleClass="secondary-button">
                <graphic><PhosphorIcon icon="CALENDAR_BLANK" size="15"/></graphic>
            </Button>
            <Button text="Nouveau projet" onAction="#handleNewProject" styleClass="secondary-button">
                <graphic><PhosphorIcon icon="BUILDINGS" size="15"/></graphic>
            </Button>
            <Button text="Nouvelle cotisation" onAction="#handleNewContribution" styleClass="primary-button">
                <graphic><PhosphorIcon icon="PLUS" size="15"/></graphic>
            </Button>
        </HBox>

    </VBox>
</ScrollPane>
