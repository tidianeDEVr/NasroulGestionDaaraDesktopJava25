<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.nasroul.ui.PhosphorIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nasroul.controller.ExpenseController"
      fx:id="rootBox" styleClass="container">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="totalLabel" styleClass="section-subtitle" text="Total : 0 CFA"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Importer Excel" onAction="#handleImportExcel" styleClass="secondary-button">
            <graphic><PhosphorIcon icon="DOWNLOAD_SIMPLE" size="15"/></graphic>
        </Button>
        <Button text="Télécharger le modèle" onAction="#handleExportTemplate" styleClass="secondary-button"/>
        <Button text="Nouvelle dépense" onAction="#handleAdd" styleClass="primary-button">
            <graphic><PhosphorIcon icon="PLUS" size="15"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label styleClass="empty-state" text="Aucune dépense enregistrée."/></placeholder>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="250"/>
            <TableColumn fx:id="colAmount" text="Montant" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colCategory" text="Catégorie" prefWidth="120"/>
            <TableColumn fx:id="colEntityType" text="Type" prefWidth="100"/>
            <TableColumn fx:id="colEntityName" text="Collecte" prefWidth="150"/>
            <TableColumn fx:id="colMember" text="Membre" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox styleClass="action-bar">
        <Button text="Supprimer" onAction="#handleDelete" styleClass="danger-button"/>
        <Button text="Modifier" onAction="#handleEdit" styleClass="secondary-button"/>
    </HBox>

</VBox>
